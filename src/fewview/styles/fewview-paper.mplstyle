# Fewview paper style: a LaTeX (Computer Modern) look for publication figures.
# Uses Matplotlib's bundled cmr10 font and cm mathtext, so it needs no LaTeX
# installation (text.usetex stays off). Applied by fewview's Matplotlib plots
# and available to your own via fewview.paper_style_file().

### Axes
axes.titlesize : large
axes.labelsize : large
axes.formatter.use_mathtext : True
axes.unicode_minus : False

### Lines
lines.linewidth : 1.0
lines.markersize : 10
hatch.linewidth: 0.25

patch.antialiased   : True

### Ticks
xtick.top: True
xtick.bottom: True
xtick.major.size: 4.0
xtick.minor.size: 2.0
xtick.major.width: 0.5
xtick.minor.width: 0.5
xtick.direction: in
xtick.minor.visible: True
xtick.major.top: True
xtick.major.bottom: True
xtick.minor.top: True
xtick.minor.bottom: True
xtick.major.pad: 5.0
xtick.minor.pad: 5.0
ytick.labelsize: large

ytick.left: True
ytick.right: True
ytick.major.size: 4.0
ytick.minor.size: 2.0
ytick.major.width: 0.5
ytick.minor.width: 0.5
ytick.direction: in
ytick.minor.visible: True
ytick.major.left: True
ytick.major.right: True
ytick.minor.left: True
ytick.minor.right: True
ytick.major.pad: 5.0
ytick.minor.pad: 5.0
xtick.labelsize: large

### Legend
legend.frameon: True
legend.fontsize: 10

### Figure size
figure.figsize: 5.0, 3.0
figure.subplot.left: 0.125
figure.subplot.bottom: 0.175
figure.subplot.top: 0.95
figure.subplot.right: 0.95
figure.autolayout : False
figure.dpi: 300

### Fonts
mathtext.fontset : cm
font.family: serif
font.serif: cmr10, Computer Modern Roman, STIXGeneral, DejaVu Serif

### Grid lines
grid.linewidth : 0.5
grid.linestyle : dashed
grid.color : 'xkcd:light gray'

### Saving figures
path.simplify : True
